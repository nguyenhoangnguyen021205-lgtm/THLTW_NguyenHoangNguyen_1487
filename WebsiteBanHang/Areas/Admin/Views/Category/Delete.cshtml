@model WebsiteBanHang.Models.Category
@{
    ViewData["Title"] = "Xóa Danh Mục";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow p-4" style="background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(220, 53, 69, 0.4); border-radius: 20px;">
            <h2 class="text-white fw-bold mb-4 brand-font"><i class="bi bi-exclamation-triangle text-danger me-2"></i>XÁC NHẬN XÓA DANH MỤC</h2>
            
            <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-white mb-4">
                Bạn có chắc chắn muốn xóa danh mục <strong>@Model.Name</strong> không? Hành động này không thể hoàn tác.
            </div>
            
            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Hủy Bỏ</a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold"><i class="bi bi-trash3 me-1"></i> Xóa Vĩnh Viễn</button>
                </div>
            </form>
        </div>
    </div>
</div>
