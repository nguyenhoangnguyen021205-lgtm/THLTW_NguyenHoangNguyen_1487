@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .stat-card {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(16px);
        border-radius: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
    }

    .border-cyan { border: 1px solid rgba(0, 240, 255, 0.4); }
    .border-magenta { border: 1px solid rgba(255, 0, 127, 0.4); }
    .border-purple { border: 1px solid rgba(139, 92, 246, 0.4); }
    .border-green { border: 1px solid rgba(16, 185, 129, 0.4); }

    .stat-card.border-cyan:hover { box-shadow: 0 10px 25px rgba(0, 240, 255, 0.2); }
    .stat-card.border-magenta:hover { box-shadow: 0 10px 25px rgba(255, 0, 127, 0.2); }
    .stat-card.border-purple:hover { box-shadow: 0 10px 25px rgba(139, 92, 246, 0.2); }
    .stat-card.border-green:hover { box-shadow: 0 10px 25px rgba(16, 185, 129, 0.2); }

    .icon-box {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 1.8rem;
    }

    .bg-cyan-glow { background: rgba(0, 240, 255, 0.1); color: #00f0ff; }
    .bg-magenta-glow { background: rgba(255, 0, 127, 0.1); color: #ff007f; }
    .bg-purple-glow { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; }
    .bg-green-glow { background: rgba(16, 185, 129, 0.1); color: #10b981; }

    .text-value {
        font-family: 'Orbitron', sans-serif;
        font-weight: 800;
        font-size: 2rem;
    }
</style>

<div class="mb-4">
    <h2 class="text-white fw-bold brand-font mb-1"><i class="bi bi-speedometer2 me-2 text-info"></i>TỔNG QUAN HỆ THỐNG</h2>
    <p class="text-white-50">Báo cáo tình hình hoạt động của hệ thống cửa hàng</p>
</div>

<div class="row g-4 mb-5">
    <!-- Thống kê Nhạc cụ -->
    <div class="col-md-6 col-lg-3">
        <div class="stat-card border-cyan p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-white-50 fw-bold m-0 text-uppercase">Tổng Sản Phẩm</h6>
                <div class="icon-box bg-cyan-glow"><i class="bi bi-box-seam"></i></div>
            </div>
            <h3 class="text-white text-value mb-0">@ViewBag.TotalProducts</h3>
            <p class="text-success small fw-bold mt-2 mb-0"><i class="bi bi-arrow-up-right me-1"></i>Đang kích hoạt</p>
        </div>
    </div>

    <!-- Thống kê Danh mục -->
    <div class="col-md-6 col-lg-3">
        <div class="stat-card border-purple p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-white-50 fw-bold m-0 text-uppercase">Danh Mục Cấu Hình</h6>
                <div class="icon-box bg-purple-glow"><i class="bi bi-tags"></i></div>
            </div>
            <h3 class="text-white text-value mb-0">@ViewBag.TotalCategories</h3>
            <p class="text-info small fw-bold mt-2 mb-0"><i class="bi bi-dash me-1"></i>Ổn định</p>
        </div>
    </div>

    <!-- Thống kê Đơn hàng -->
    <div class="col-md-6 col-lg-3">
        <div class="stat-card border-magenta p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-white-50 fw-bold m-0 text-uppercase">Đơn Hàng (Tháng)</h6>
                <div class="icon-box bg-magenta-glow"><i class="bi bi-cart-check"></i></div>
            </div>
            <h3 class="text-white text-value mb-0">@ViewBag.TotalOrders</h3>
            <p class="text-success small fw-bold mt-2 mb-0"><i class="bi bi-arrow-up-right me-1"></i>+12% so với tháng trước</p>
        </div>
    </div>

    <!-- Thống kê Doanh thu -->
    <div class="col-md-6 col-lg-3">
        <div class="stat-card border-green p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-white-50 fw-bold m-0 text-uppercase">Doanh Thu Tạm Tính</h6>
                <div class="icon-box bg-green-glow"><i class="bi bi-cash-coin"></i></div>
            </div>
            <h3 class="text-white text-value mb-0" style="font-size: 1.5rem;">@ViewBag.TotalRevenue.ToString("#,##0") đ</h3>
            <p class="text-success small fw-bold mt-2 mb-0"><i class="bi bi-arrow-up-right me-1"></i>+8.4% so với tháng trước</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow p-4 h-100" style="background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(139, 92, 246, 0.4); border-radius: 20px;">
            <h4 class="text-white fw-bold mb-4 brand-font"><i class="bi bi-activity text-danger me-2"></i>Hoạt động gần đây</h4>
            <ul class="list-group list-group-flush rounded-3" style="background: transparent;">
                <li class="list-group-item text-white border-secondary" style="background: rgba(15, 23, 42, 0.6);"><i class="bi bi-circle-fill text-success me-3 small"></i>Quản trị viên <b>Hoàng Nguyên</b> vừa đăng nhập. <span class="float-end text-white-50 small">Vài giây trước</span></li>
                <li class="list-group-item text-white border-secondary" style="background: transparent;"><i class="bi bi-circle-fill text-info me-3 small"></i>Hệ thống đã cập nhật số lượng nhạc cụ thành công. <span class="float-end text-white-50 small">5 phút trước</span></li>
                <li class="list-group-item text-white border-secondary" style="background: rgba(15, 23, 42, 0.6);"><i class="bi bi-circle-fill text-warning me-3 small"></i>Đơn hàng #OD-1029 đã được thanh toán. <span class="float-end text-white-50 small">2 giờ trước</span></li>
                <li class="list-group-item text-white border-secondary" style="background: transparent;"><i class="bi bi-circle-fill text-primary me-3 small"></i>Khách hàng mới đã đăng ký tài khoản. <span class="float-end text-white-50 small">Hôm qua</span></li>
            </ul>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow p-4 h-100" style="background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(0, 240, 255, 0.4); border-radius: 20px;">
            <h4 class="text-white fw-bold mb-4 brand-font"><i class="bi bi-hdd-network text-info me-2"></i>Trạng thái Server</h4>
            <div class="mb-4">
                <div class="d-flex justify-content-between text-white mb-1 small fw-bold"><span>CPU Usage</span><span class="text-info">24%</span></div>
                <div class="progress" style="height: 8px; background: rgba(255,255,255,0.1);">
                    <div class="progress-bar bg-info" role="progressbar" style="width: 24%;"></div>
                </div>
            </div>
            <div class="mb-4">
                <div class="d-flex justify-content-between text-white mb-1 small fw-bold"><span>RAM Usage (16GB)</span><span class="text-warning">6.2GB</span></div>
                <div class="progress" style="height: 8px; background: rgba(255,255,255,0.1);">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: 45%;"></div>
                </div>
            </div>
            <div>
                <div class="d-flex justify-content-between text-white mb-1 small fw-bold"><span>Database Storage</span><span class="text-success">1.2GB / 50GB</span></div>
                <div class="progress" style="height: 8px; background: rgba(255,255,255,0.1);">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 15%;"></div>
                </div>
            </div>
            <div class="mt-auto pt-4 text-center">
                <span class="badge border border-success text-success px-4 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-2"></i>Hệ thống hoạt động ổn định</span>
            </div>
        </div>
    </div>
</div>
