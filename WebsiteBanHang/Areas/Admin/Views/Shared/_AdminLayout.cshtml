<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Cyber Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;700;800;900&display=swap&subset=vietnamese" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --bg-main: #0f172a;
            --text-main: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
        }

        .admin-sidebar {
            background: rgba(30, 41, 59, 0.9);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(139, 92, 246, 0.3);
            min-height: 100vh;
            position: fixed;
            width: 280px;
        }

        .admin-main {
            margin-left: 280px;
            padding: 2rem;
        }

        .nav-link {
            color: #94a3b8;
            font-weight: 500;
            padding: 1rem 1.5rem;
            border-left: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #f8fafc;
            background: rgba(139, 92, 246, 0.1);
            border-left: 3px solid #8b5cf6;
        }

        .brand-font {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
        }

        .text-gradient {
            background: linear-gradient(90deg, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            color: transparent !important;
        }
    </style>
</head>
<body>
    <div class="admin-sidebar py-4">
        <h3 class="px-4 mb-4 brand-font text-gradient"><i class="bi bi-shield-lock-fill me-2"></i>ADMIN PANEL</h3>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam me-2"></i> Quản lý Sản Phẩm</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="bi bi-tags me-2"></i> Quản lý Danh Mục</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Order" asp-action="Index"><i class="bi bi-cart-check me-2"></i> Quản lý Đơn Hàng</a>
            </li>
            <li class="nav-item mt-5 px-3">
                <a class="btn btn-outline-info w-100 fw-bold" asp-area="" asp-controller="Product" asp-action="Index"><i class="bi bi-arrow-left me-2"></i> Trở Về Store</a>
            </li>
        </ul>
    </div>

    <div class="admin-main">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
