@model WebsiteBanHang.Models.Product
@{
    ViewData["Title"] = "Thêm Nhạc Cụ";
}

<style>
    .form-card {
        background: rgba(30, 41, 59, 0.7) !important;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(139, 92, 246, 0.4) !important;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    }

    .form-label {
        color: #f8fafc !important;
        font-weight: 700;
        font-size: 1.05rem;
        margin-bottom: 0.5rem;
    }

    .custom-input {
        background: rgba(15, 23, 42, 0.8) !important;
        color: #f8fafc !important;
        border: 1px solid rgba(148, 163, 184, 0.3) !important;
        font-weight: 500;
        padding: 12px;
        transition: all 0.3s ease;
    }

    .custom-input:focus {
        border-color: #3b82f6 !important;
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.3) !important;
        background: rgba(15, 23, 42, 0.95) !important;
        color: white !important;
    }

    /* Fix lỗi trình duyệt tự điền (autofill) làm ô nhập biến thành màu trắng */
    .custom-input:-webkit-autofill,
    .custom-input:-webkit-autofill:hover, 
    .custom-input:-webkit-autofill:focus, 
    .custom-input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 1000px #0f172a inset !important;
        -webkit-text-fill-color: #ffffff !important;
        caret-color: #ffffff;
        border: 1px solid #3b82f6 !important;
    }

    .preview-container {
        border: 2px dashed rgba(148, 163, 184, 0.5);
        border-radius: 12px;
        background: rgba(15, 23, 42, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    
    .preview-container:hover {
        border-color: #8b5cf6;
        box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
    }

    #previewImage {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }
</style>

<div class="card form-card shadow p-4">
    <h3 class="text-white fw-bold mb-4 brand-font">➕ THÊM NHẠC CỤ MỚI</h3>
    <form asp-action="Add" method="post" enctype="multipart/form-data">
        <div class="row g-4">
            <div class="col-md-7">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Tên Nhạc Cụ</label>
                    <input asp-for="Name" class="form-control custom-input rounded-3 text-white" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">Giá Bán</label>
                        <input asp-for="Price" type="number" class="form-control custom-input rounded-3 text-white" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label">Số Lượng Kho</label>
                        <input asp-for="Stock" type="number" class="form-control custom-input rounded-3 text-white" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Danh Mục</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select custom-input rounded-3 text-white" required></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô Tả</label>
                    <textarea asp-for="Description" class="form-control custom-input rounded-3 text-white" rows="3" required></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label">Cách 1: Dán Link Ảnh Trực Tuyến (URL)</label>
                    <input asp-for="ImageUrl" id="urlInput" class="form-control custom-input rounded-3 text-white" placeholder="https://example.com/anh-dan.jpg" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Cách 2: Hoặc Chọn File Ảnh Từ Máy Tính</label>
                    <input type="file" name="imageFile" id="imageInput" class="form-control custom-input rounded-3 text-white" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-premium px-4 py-2 mt-3"><i class="bi bi-save me-2"></i> Lưu Lại</button>
                <a asp-action="Manage" class="btn btn-secondary fw-bold px-4 py-2 text-white ms-2 mt-3">Quay Lại</a>
            </div>

            <div class="col-md-5 d-flex flex-column align-items-center justify-content-start border-start border-secondary pt-2">
                <label class="form-label mb-3 text-uppercase text-white fw-bold">Ảnh Xem Trước</label>
                <div class="preview-container" style="width: 100%; aspect-ratio: 1/1; max-width: 400px;">
                    <img id="previewImage" src="https://images.unsplash.com/photo-1511192336575-5a79af67a629?w=500&q=80" 
                         alt="Preview Image" 
                         onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1511192336575-5a79af67a629?w=500&q=80';" />
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Preview khi dán link URL
        document.getElementById('urlInput').addEventListener('input', function (e) {
            if (e.target.value) document.getElementById('previewImage').src = e.target.value;
        });
        // Preview khi chọn file máy tính
        document.getElementById('imageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) { document.getElementById('previewImage').src = e.target.result; };
                reader.readAsDataURL(file);
            }
        });
    </script>
}