@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-10 col-lg-8">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            
            <div class="mb-4">
                <label asp-for="Input.OldPassword" class="form-label text-white fw-bold"><i class="bi bi-key me-2 text-warning"></i>Mật khẩu cũ</label>
                <input asp-for="Input.OldPassword" class="form-control bg-dark text-white border-secondary" autocomplete="current-password" aria-required="true" placeholder="Nhập mật khẩu hiện tại của bạn" />
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Input.NewPassword" class="form-label text-white fw-bold"><i class="bi bi-key-fill me-2 text-success"></i>Mật khẩu mới</label>
                <input asp-for="Input.NewPassword" class="form-control bg-dark text-white border-secondary" autocomplete="new-password" aria-required="true" placeholder="Nhập mật khẩu mới" />
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label text-white fw-bold"><i class="bi bi-check2-all me-2 text-info"></i>Xác nhận mật khẩu mới</label>
                <input asp-for="Input.ConfirmPassword" class="form-control bg-dark text-white border-secondary" autocomplete="new-password" aria-required="true" placeholder="Xác nhận lại mật khẩu mới"/>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            
            <div class="mt-5">
                <button type="submit" class="btn btn-warning text-dark fw-bold px-5 rounded-pill shadow">
                    <i class="bi bi-shield-check me-2"></i>Cập nhật mật khẩu
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
