<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sonic Cyber Store</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Plus+Jakarta+Sans:wght@700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #0b0720;
            color: #ffffff !important;
        }

        .neon-navbar {
            background: #120b38 !important;
            border-bottom: 3px solid #ff007f;
            box-shadow: 0 0 20px #ff007f;
        }

        .neon-brand {
            font-family: 'Orbitron', sans-serif;
            color: #00f0ff !important;
            text-shadow: 0 0 10px #00f0ff;
            font-weight: 900;
            letter-spacing: 2px;
        }

        .cyber-panel {
            background: #170f41 !important;
            border: 2px solid #00f0ff !important;
            border-radius: 16px;
            box-shadow: 0 0 15px rgba(0,240,255,0.2);
        }

        .cyber-link {
            color: #ffffff !important;
            text-decoration: none;
            padding: 15px 20px;
            display: block;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            font-weight: 800;
            font-size: 1.05rem;
            transition: all 0.3s;
        }

            .cyber-link:hover {
                background: linear-gradient(90deg, #ff007f, transparent) !important;
                color: #ffffff !important;
                padding-left: 25px;
                text-shadow: 0 0 8px #fff;
            }

        .text-neon-cyan {
            color: #00f0ff !important;
            font-weight: 900;
            text-shadow: 0 0 5px #00f0ff;
        }

        label, p, span, h1, h2, h3, h4, h5, h6 {
            color: #ffffff !important;
            font-weight: 700;
        }

        .form-control, .form-select {
            background-color: #080417 !important;
            border: 1px solid #00f0ff !important;
            color: white !important;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark neon-navbar py-3 sticky-top">
        <div class="container">
            <a class="navbar-brand neon-brand" asp-controller="Product" asp-action="Index"><i class="bi bi-speakers-fill me-2"></i>SONIC CLUB</a>
            <div class="collapse navbar-collapse">
                <form class="d-flex ms-auto me-3" asp-controller="Product" asp-action="Index" method="get">
                    <input class="form-control me-2 fw-bold text-white" type="search" name="searchString" placeholder="Tìm kiếm tên nhạc cụ...">
                    <button class="btn btn-info fw-bold text-dark shadow" type="submit"><i class="bi bi-search"></i> Tìm Kiếm</button>
                </form>
                <div class="navbar-nav gap-2">
                    <a class="nav-link text-white fw-bold px-3 fs-5" asp-controller="Product" asp-action="Index">Showroom</a>
                    <a class="btn btn-danger fw-bold px-4 rounded-3 shadow-lg border-2 border-white text-white" asp-controller="Product" asp-action="Manage"><i class="bi bi-shield-lock-fill me-1"></i> TRANG QUẢN TRỊ ADMIN</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <div class="row g-4">
            <div class="col-lg-3">
                <div class="card cyber-panel overflow-hidden shadow">
                    <div class="p-3 text-center fw-bold text-uppercase bg-black text-neon-cyan font-monospace" style="font-size: 1.15rem; letter-spacing: 1px;">⚡ PHÂN LOẠI SẢN PHẨM</div>
                    <a href="@Url.Action("Index", "Product")" class="cyber-link text-warning fw-bold">🌟 TẤT CẢ SẢN PHẨM</a>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            <a href="@Url.Action("Index", "Product", new { categoryId = cat.Id })" class="cyber-link">
                                🎵 @cat.Name
                            </a>
                        }
                    }
                </div>
            </div>
            <div class="col-lg-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>