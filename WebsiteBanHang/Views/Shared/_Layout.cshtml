<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sonic Cyber Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;700;800;900&display=swap&subset=vietnamese" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --bg-main: #0f172a; /* Slate 900 */
            --bg-panel: #1e293b; /* Slate 800 */
            --accent-primary: #3b82f6; /* Blue 500 */
            --accent-secondary: #8b5cf6; /* Violet 500 */
            --text-main: #f8fafc; /* Slate 50 */
            --text-muted: #94a3b8; /* Slate 400 */
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-main);
            color: var(--text-main) !important;
            min-height: 100vh;
        }

        /* Headings use Montserrat */
        h1, h2, h3, h4, h5, h6, .brand-font {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
        }

        .neon-navbar {
            background: rgba(15, 23, 42, 0.8) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(59, 130, 246, 0.3);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }

        .neon-brand {
            color: transparent !important;
            background: linear-gradient(90deg, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
            font-weight: 900;
            letter-spacing: 1px;
            font-family: 'Montserrat', sans-serif;
        }

        .cyber-panel {
            background: rgba(30, 41, 59, 0.7) !important;
            backdrop-filter: blur(12px);
            border: 1px solid rgba(139, 92, 246, 0.3) !important;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .cyber-link {
            color: var(--text-main) !important;
            text-decoration: none;
            padding: 14px 20px;
            display: block;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .cyber-link:hover {
            background: linear-gradient(90deg, rgba(139, 92, 246, 0.2), transparent) !important;
            color: #c4b5fd !important;
            padding-left: 25px;
            border-left: 3px solid var(--accent-secondary);
        }

        .text-neon-cyan {
            color: #38bdf8 !important;
            font-weight: 800;
        }

        label, p, span {
            color: var(--text-main) !important;
        }

        .form-control, .form-select {
            background-color: rgba(15, 23, 42, 0.6) !important;
            border: 1px solid rgba(148, 163, 184, 0.3) !important;
            color: white !important;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent-primary) !important;
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25) !important;
        }

        .form-control::placeholder {
            color: var(--text-muted) !important;
        }

        .btn-premium {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: white !important;
            border: none;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(139, 92, 246, 0.4);
            color: white !important;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark neon-navbar py-3 sticky-top">
        <div class="container">
            <a class="navbar-brand neon-brand" asp-area="" asp-controller="Product" asp-action="Index"><i class="bi bi-speakers-fill me-2"></i>SONIC CLUB</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 gap-md-3">
                    <li class="nav-item">
                        <a class="nav-link text-white fw-bold" asp-area="" asp-controller="Product" asp-action="Index">Trang Chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white fw-bold" asp-area="" asp-controller="Product" asp-action="Index">Showroom</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white fw-bold" asp-area="" asp-controller="ShoppingCart" asp-action="Index"><i class="bi bi-cart3 me-1"></i>Giỏ Hàng</a>
                    </li>
                </ul>

                <form class="d-flex mx-lg-3 my-2 my-lg-0" asp-area="" asp-controller="Product" asp-action="Index" method="get">
                    <input class="form-control form-control-sm me-2 fw-bold text-white" type="search" name="searchString" placeholder="Tìm kiếm..." style="max-width: 180px;">
                    <button class="btn btn-sm btn-premium px-3 shadow-sm rounded-3" type="submit"><i class="bi bi-search"></i></button>
                </form>

                <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-sm btn-premium px-3 rounded-3 shadow-lg text-nowrap" asp-area="Admin" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-shield-lock-fill me-1"></i> ADMIN
                        </a>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <div class="row g-4">
            <div class="col-lg-3">
                <div class="card cyber-panel overflow-hidden shadow">
                    <div class="p-3 text-center fw-bold text-uppercase bg-black text-neon-cyan font-monospace" style="font-size: 1.15rem; letter-spacing: 1px;">⚡ PHÂN LOẠI SẢN PHẨM</div>
                    <a href="@Url.Action("Index", "Product", new { area = "" })" class="cyber-link text-warning fw-bold">🌟 TẤT CẢ SẢN PHẨM</a>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            <a href="@Url.Action("Index", "Product", new { categoryId = cat.Id, area = "" })" class="cyber-link">
                                🎵 @cat.Name
                            </a>
                        }
                    }
                </div>
            </div>
            <div class="col-lg-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>