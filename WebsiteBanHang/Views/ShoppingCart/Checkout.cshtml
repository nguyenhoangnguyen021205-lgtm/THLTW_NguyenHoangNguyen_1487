@model WebsiteBanHang.Models.Order
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card form-card shadow-lg p-4 p-md-5">
                <h3 class="text-white fw-bold mb-4 brand-font text-center"><i class="bi bi-credit-card-2-front text-warning me-2"></i>THÔNG TIN THANH TOÁN</h3>
                
                <form asp-action="Checkout" method="post">
                    <div class="mb-4">
                        <label asp-for="ShippingAddress" class="form-label text-white fw-bold"><i class="bi bi-geo-alt me-1 text-info"></i>Địa Chỉ Giao Hàng</label>
                        <textarea asp-for="ShippingAddress" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Nhập địa chỉ nhận hàng chi tiết..." required></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label text-white fw-bold"><i class="bi bi-journal-text me-1 text-success"></i>Ghi Chú Đơn Hàng</label>
                        <textarea asp-for="Notes" class="form-control bg-dark text-white border-secondary" rows="2" placeholder="Ví dụ: Giao hàng giờ hành chính..."></textarea>
                    </div>

                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-warning text-dark btn-lg fw-bold rounded-pill shadow-lg">
                            <i class="bi bi-check2-circle me-2"></i>Xác Nhận Đặt Hàng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
