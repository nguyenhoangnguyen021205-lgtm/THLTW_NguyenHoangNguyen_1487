@model WebsiteBanHang.Models.Product
@{
    ViewData["Title"] = "Sửa Nhạc Cụ";
}

<style>
    .form-card {
        background: #130a35;
        border: 2px solid #ff007f;
        border-radius: 20px;
    }

    .form-label {
        color: #00f0ff !important;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .custom-input {
        background: #070417 !important;
        color: #ffffff !important;
        border: 1px solid #00f0ff !important;
        font-weight: 600;
        padding: 12px;
    }
</style>

<div class="card form-card shadow p-4">
    <h3 class="text-white fw-bold mb-4" style="font-family: 'Orbitron';">🛠️ CHỈNH SỬA THÔNG TIN NHẠC CỤ</h3>
    <form asp-action="Update" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="row g-4">
            <div class="col-md-7">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Tên Nhạc Cụ</label>
                    <input asp-for="Name" class="form-control custom-input rounded-3 text-white" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">Giá Bán</label>
                        <input asp-for="Price" type="number" class="form-control custom-input rounded-3 text-white" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label">Số Lượng Kho</label>
                        <input asp-for="Stock" type="number" class="form-control custom-input rounded-3 text-white" />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Danh Mục</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select custom-input rounded-3 text-white"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô Tả</label>
                    <textarea asp-for="Description" class="form-control custom-input rounded-3 text-white" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label">Đường Dẫn Link Ảnh (URL hiện tại)</label>
                    <input asp-for="ImageUrl" id="urlInput" class="form-control custom-input rounded-3 text-white" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Hoặc Tải Lên Tệp Ảnh Mới Để Thay Thế</label>
                    <input type="file" name="imageFile" id="imageInput" class="form-control custom-input rounded-3 text-white" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-warning fw-bold px-4 py-2 text-dark shadow mt-3">⚙️ Lưu Thay Đổi</button>
                <a asp-action="Manage" class="btn btn-secondary fw-bold px-4 py-2 text-white ms-2 mt-3">Quay Lại</a>
            </div>

            <div class="col-md-5 d-flex flex-column align-items-center justify-content-start border-start border-secondary pt-2">
                <label class="form-label mb-3 text-uppercase text-white fw-bold">Hình Ảnh Đang Hiển Thị</label>
                <div class="border border-info rounded p-2 bg-black d-flex align-items-center justify-content-center shadow-lg" style="width: 300px; height: 300px; overflow: hidden;">
                    <img id="previewImage" src="@Model.ImageUrl" alt="Product Image" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('urlInput').addEventListener('input', function (e) {
            if (e.target.value) document.getElementById('previewImage').src = e.target.value;
        });
        document.getElementById('imageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) { document.getElementById('previewImage').src = e.target.result; };
                reader.readAsDataURL(file);
            }
        });
    </script>
}