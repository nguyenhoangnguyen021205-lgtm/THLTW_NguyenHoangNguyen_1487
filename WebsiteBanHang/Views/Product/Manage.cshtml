@model IEnumerable<WebsiteBanHang.Models.Product>
@{
    ViewData["Title"] = "Hệ thống Quản Trị Cửa Hàng - Admin";
    var categories = ViewBag.Categories as IEnumerable<WebsiteBanHang.Models.Category>;
}

<div class="container mt-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="fw-bold text-dark mb-1"><i class="bi bi-sliders me-2 text-danger"></i>Hệ thống Quản Lý</h2>
                <p class="text-muted mb-0">Trang quản trị kho hàng và thông tin sản phẩm nhạc cụ</p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <a class="btn btn-danger shadow-sm rounded-pill px-4" asp-action="Add">
                    <i class="bi bi-plus-circle me-2"></i> Thêm Nhạc Cụ Mới
                </a>
            </div>
        </div>

        <div class="table-responsive rounded-3 overflow-hidden">
            <table class="table table-hover align-middle border mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">Hình ảnh</th>
                        <th>Tên nhạc cụ</th>
                        <th>Danh mục</th>
                        <th class="text-end">Giá bán</th>
                        <th class="text-center" style="width: 120px;">Kho hàng</th>
                        <th class="text-center" style="width: 180px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=500" : item.ImageUrl)"
                                     class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" alt="">
                            </td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 250px;">@item.Name</div>
                                @if (item.IsFeatured)
                                {
                                    <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;">HOT</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary px-2 py-1">
                                    @(categories != null ? categories.FirstOrDefault(c => c.Id == item.CategoryId)?.Name : "Nhạc cụ")
                                </span>
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @item.Price.ToString("#,##0") đ
                            </td>
                            <td class="text-center">
                                @if (item.Stock <= 3)
                                {
                                    <span class="badge bg-light-danger text-danger border border-danger rounded-pill px-2">Chỉ còn @item.Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-light-success text-success border border-success rounded-pill px-2">Còn @item.Stock</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a class="btn btn-sm btn-outline-secondary rounded-pill px-3" asp-action="Update" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-square me-1"></i> Sửa
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger rounded-pill px-2" asp-action="Delete" asp-route-id="@item.Id"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa nhạc cụ này khỏi kho dữ liệu?')">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-light-success {
        background-color: #e8f5e9;
    }

    .bg-light-danger {
        background-color: #ffebee;
    }
</style>