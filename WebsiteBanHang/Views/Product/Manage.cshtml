@model IEnumerable<WebsiteBanHang.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Hệ Thống";
}

<style>
    /* BẢNG ĐIỀU KHIỂN SÁNG RÕ - CHỮ TRẮNG TOÀN BỘ KHÔNG LO BỊ MỜ ẨN */
    .admin-card {
        background: #140e38 !important;
        border: 2px solid #00f0ff !important;
        border-radius: 16px;
    }
    /* Ép tất cả các tiêu đề, chữ trong bảng phải hiển thị màu trắng tinh, đậm nét */
    .text-force-white {
        color: #ffffff !important;
        font-weight: 700 !important;
        text-shadow: 1px 1px 2px #000000;
    }

    .text-force-cyan {
        color: #00f0ff !important;
        font-weight: 800 !important;
    }

    .manage-table th {
        background-color: #09051c !important;
        color: #00f0ff !important;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.95rem;
        border-bottom: 2px solid #00f0ff !important;
        padding: 15px !important;
    }

    .manage-table td {
        border-bottom: 1px solid rgba(0, 240, 255, 0.15) !important;
        padding: 15px !important;
    }

    .thumb-preview {
        width: 65px;
        height: 65px;
        object-fit: contain;
        background: #070417;
        border-radius: 8px;
    }
    /* Định dạng lại các ô nhập liệu / text hiển thị rõ ràng */
    .badge-stock {
        font-size: 0.95rem !important;
        font-weight: bold !important;
        padding: 8px 16px !important;
    }
</style>

<div class="card admin-card shadow-lg p-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 border-bottom border-secondary pb-3">
        <div>
            <h2 class="text-force-white m-0" style="font-family: 'Orbitron'; letter-spacing: 1px;">⚙️ CONSOLE ĐIỀU HÀNH KHO HÀNG</h2>
            <p class="text-white-50 small m-0 font-weight-bold">Hệ thống quản lý thông tin, cập nhật sửa đổi nhạc cụ trực tiếp xuống SQL Server.</p>
        </div>
        <a href="@Url.Action("Add", "Product")" class="btn btn-success btn-lg px-4 py-2 rounded-3 fw-bold shadow border-2 border-white text-white">
            <i class="bi bi-plus-circle-fill me-2"></i> THÊM NHẠC CỤ MỚI
        </a>
    </div>

    <div class="table-responsive rounded-3">
        <table class="table align-middle manage-table mb-0 bg-transparent text-white">
            <thead>
                <tr>
                    <th scope="col" class="text-force-cyan">Hình Ảnh</th>
                    <th scope="col" class="text-force-cyan">Tên Nhạc Cụ / Thiết Bị</th>
                    <th scope="col" class="text-force-cyan">Giá Niêm Yết</th>
                    <th scope="col" class="text-center text-force-cyan">Số Lượng Kho</th>
                    <th scope="col" class="text-center text-force-cyan">Thao Tác Hệ Thống</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.ImageUrl" class="thumb-preview border border-info" alt="nhac-cu"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1511192336575-5a79af67a629?w=100&q=80';">
                        </td>
                        <td>
                            <span class="d-block text-force-white fs-5">@item.Name</span>
                            <span class="badge bg-black text-info border border-info mt-1 px-2 py-1" style="font-size: 0.8rem;">@item.Category?.Name</span>
                        </td>
                        <td>
                            <span class="text-force-cyan font-monospace fs-5">@item.Price.ToString("#,##0") đ</span>
                        </td>
                        <td class="text-center">
                            <span class="badge badge-stock @(item.Stock > 10 ? "bg-success text-white border border-light" : "bg-danger text-white border border-light")">
                                @item.Stock Thiết bị
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="@Url.Action("Update", "Product", new { id = item.Id })" class="btn btn-sm btn-warning text-dark fw-bold px-3 py-2 rounded-2 shadow">
                                    <i class="bi bi-pencil-square me-1"></i> Sửa Thông Tin
                                </a>
                                <a href="@Url.Action("Delete", "Product", new { id = item.Id })" class="btn btn-sm btn-danger text-white fw-bold px-3 py-2 rounded-2 shadow"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa nhạc cụ này khỏi cơ sở dữ liệu SQL Server không?');">
                                    <i class="bi bi-trash3 me-1"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>