@model IEnumerable<WebsiteBanHang.Models.Product>

@{
    ViewData["Title"] = "Không Gian Âm Nhạc";
}

<style>
    .cyber-card {
        background: #130a35;
        border: 2px solid #00f0ff;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s;
    }

        .cyber-card:hover {
            transform: translateY(-8px);
            border-color: #ff007f;
            box-shadow: 0 0 25px #ff007f !important;
        }

    .img-box {
        height: 210px;
        background: #070417;
        padding: 15px;
        border-bottom: 1px solid rgba(0,240,255,0.1);
    }

        .img-box img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

    /* Giao diện màu sắc nổi bật, chữ trắng tinh khôi dễ nhìn */
    .text-bright-title {
        color: #ffffff !important;
        font-weight: 800;
        font-size: 1.15rem;
    }

    .text-bright-desc {
        color: #f1edff !important;
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.5;
    }

    .price-tag {
        color: #00f0ff;
        font-weight: 900;
        font-size: 1.4rem;
        text-shadow: 0 0 5px rgba(0,240,255,0.6);
        font-family: 'Orbitron', sans-serif;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-4 border-bottom border-secondary pb-3">
    <h3 class="fw-bold m-0 text-white" style="font-family: 'Orbitron'; letter-spacing: 1px;">⚡ SIÊU THỊ NHẠC CỤ ĐIỆN TỬ PREMIUM</h3>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 border-0 cyber-card shadow">
                <div class="img-box d-flex align-items-center justify-content-center">
                    <img src="@item.ImageUrl" alt="@item.Name">
                </div>

                <div class="card-body d-flex flex-column p-4">
                    <span class="text-info small fw-bold text-uppercase mb-1" style="letter-spacing: 0.5px;">★ @item.Category?.Name</span>
                    <h5 class="text-bright-title mb-2 text-truncate" title="@item.Name">@item.Name</h5>
                    <p class="text-bright-desc mb-3" style="height: 45px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">@item.Description</p>

                    <div class="d-flex justify-content-between align-items-center mt-auto border-top border-secondary pt-3">
                        <div class="price-tag">@item.Price.ToString("#,##0") đ</div>
                        <div class="text-end small text-white fw-bold">
                            <div>Tồn kho: <span class="text-warning">@item.Stock</span></div>
                            <div class="text-warning">⭐ @item.Rating.ToString("0.0")</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                    <div class="d-flex gap-2">
                        <a asp-action="Display" asp-route-id="@item.Id" class="btn btn-outline-info w-50 fw-bold rounded-3 py-2">Chi Tiết</a>
                        <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-productId="@item.Id" class="btn btn-warning text-dark fw-bold rounded-pill px-4 flex-grow-1 shadow">
                            <i class="bi bi-cart-plus-fill me-1"></i>Mua ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>